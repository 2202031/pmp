<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supervisión de Cortes"
            android:textColor="#003B24"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Formulario basado en el formato de reporte de supervisiones"
            android:textColor="#4F6B5D"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_login_glass"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <EditText
                android:id="@+id/etNotificacion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_login"
                android:hint="Número y año de notificación"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#1F2937" />

            <EditText
                android:id="@+id/etKwh"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:hint="KWh"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#1F2937" />

            <EditText
                android:id="@+id/etImporte"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:hint="Importe"
                android:inputType="numberDecimal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#1F2937" />

            <EditText
                android:id="@+id/etRpu"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:hint="RPU Notificación"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#1F2937" />

            <EditText
                android:id="@+id/etOrdenCorte"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:hint="No. de orden de corte"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#1F2937" />

            <EditText
                android:id="@+id/etTarifa"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:hint="Tarifa"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="#111827"
                android:textColorHint="#1F2937" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Status de servicio"
                android:textColor="#003B24"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgStatusServicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton android:text="Con energía" android:textColor="#111827" />
                <RadioButton android:text="Cortado" android:textColor="#111827" />
                <RadioButton android:text="Desmantelado" android:textColor="#111827" />
                <RadioButton android:text="Otro servicio" android:textColor="#111827" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Datos del corte"
                android:textColor="#003B24"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDatosCorte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton android:text="De poste" android:textColor="#111827" />
                <RadioButton android:text="De red" android:textColor="#111827" />
                <RadioButton android:text="De registro" android:textColor="#111827" />
                <RadioButton android:text="De base" android:textColor="#111827" />

            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Evidencia fotográfica"
                android:textColor="#003B24"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:gravity="center"
                android:text="Adjuntar foto de corte"
                android:textColor="#111827"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:gravity="center"
                android:text="Adjuntar foto de fachada"
                android:textColor="#111827"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:gravity="center"
                android:text="Adjuntar foto de medidor asegurado"
                android:textColor="#111827"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:gravity="center"
                android:text="Adjuntar foto selfi"
                android:textColor="#111827"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnGuardarReporte"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_button_login"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Guardar reporte"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>