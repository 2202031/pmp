<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0EC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="38dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <!-- Encabezado -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_dashboard_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Checklist de seguridad"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Supervisor"
                android:textColor="#D1FAE5"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Banner -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dashboard_banner"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seguridad e higiene"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Completa esta etapa antes de habilitar el reporte del Técnico."
                android:textColor="#D1FAE5"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Información de supervisión -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_green"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtFolioChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Folio:"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCircuitoChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Circuito:"
                android:textColor="#374151"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtResponsableChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Técnico responsable:"
                android:textColor="#374151"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtEstadoChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Estado: Pendiente"
                android:textColor="#006341"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtFechaChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fecha: Sin guardar"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtSupervisorChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Supervisor: Administrador"
                android:textColor="#6B7280"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Progreso -->

        <TextView
            android:id="@+id/txtProgresoChecklist"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_dashboard_banner"
            android:gravity="center"
            android:text="Progreso: 0 de 7 (0%)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 1. Área delimitada -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Área delimitada"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgAreaDelimitada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAreaSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbAreaNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbAreaNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- 2. Equipo de protección -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Equipo de protección personal"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgEquipoProteccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbEquipoSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbEquipoNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbEquipoNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- 3. Corte visible -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Corte visible"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCorteVisible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbCorteSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbCorteNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbCorteNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- 4. Detección de potencial -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Detección de corte de potencial"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgDeteccionPotencial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbPotencialSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbPotencialNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbPotencialNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- 5. Cero metales -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Cero metales"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgCeroMetales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbMetalesSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbMetalesNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbMetalesNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- 6. Actividades que salvan vidas -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Actividades que salvan vidas"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgActividadesSalvanVidas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbActividadesSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbActividadesNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbActividadesNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- 7. Llenado RIM -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7. Llenado correcto de RIM cuando aplique"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgLlenadoRim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbRimSi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="Sí"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbRimNo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="#006341"
                    android:text="No"
                    android:textColor="#374151" />

                <RadioButton
                    android:id="@+id/rbRimNoAplica"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:buttonTint="#006341"
                    android:text="No aplica"
                    android:textColor="#374151" />

            </RadioGroup>

        </LinearLayout>

        <!-- Observaciones -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_green"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observaciones generales"
                android:textColor="#111827"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etObservacionesChecklist"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input_login"
                android:gravity="top|start"
                android:hint="Registra observaciones adicionales..."
                android:inputType="textCapSentences|textMultiLine"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Botones -->

        <TextView
            android:id="@+id/btnGuardarAvance"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input_login"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Guardar avance"
            android:textColor="#006341"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCompletarChecklist"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_button_login"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Completar checklist"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>