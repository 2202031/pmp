<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8F0EC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="38dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:background="@drawable/bg_dashboard_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Evidencias fotográficas"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Supervisión de Cortes"
                    android:textColor="#D1FAE5"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▣"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dashboard_banner"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtFolioEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SUP-000"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtContadorEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0 de 4 evidencias registradas"
                android:textColor="#D1FAE5"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtModoEvidencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Puedes agregar, reemplazar o eliminar fotografías."
                android:textColor="#D1FAE5"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Foto corte -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_green"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Foto del corte"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFotoCorte"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:contentDescription="Foto del corte"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/txtEstadoFotoCorte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Evidencia pendiente"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFotoCorte"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Agregar fotografía"
                android:textColor="#006341"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Foto fachada -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_green"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Foto de fachada"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFotoFachada"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:contentDescription="Foto de fachada"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/txtEstadoFotoFachada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Evidencia pendiente"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFotoFachada"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Agregar fotografía"
                android:textColor="#006341"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Foto medidor -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_green"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Foto del medidor asegurado"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFotoMedidor"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:contentDescription="Foto del medidor asegurado"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/txtEstadoFotoMedidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Evidencia pendiente"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFotoMedidor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Agregar fotografía"
                android:textColor="#006341"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Foto selfi -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_green"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Foto selfi"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFotoSelfi"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:contentDescription="Foto selfi"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@android:drawable/ic_menu_camera" />

            <TextView
                android:id="@+id/txtEstadoFotoSelfi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="Evidencia pendiente"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnFotoSelfi"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_login"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Agregar fotografía"
                android:textColor="#006341"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnVolverReporte"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_login"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Guardar evidencias y volver"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>